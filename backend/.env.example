# Copy to .env and fill in. .env is gitignored.
#
# From https://developer.spotify.com/dashboard (create an app, add the
# redirect URI below to its settings).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/callback

# Obtained once via the Authorization Code flow, then stored here so the
# backend can mint access tokens without a browser login.
SPOTIFY_REFRESH_TOKEN=

# Optional shared secret the ESP32 sends so random internet traffic can't
# trigger playback if the backend is publicly reachable.
DEVICE_API_KEY=
